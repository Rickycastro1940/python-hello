# Milestone 7 RAG configuration.
# Copy to .env and adjust. All values have safe local defaults if unset.

# Qdrant: point at the docker-compose service (server mode). If unset, the code
# falls back to embedded on-disk mode at data/qdrant_storage/.
QDRANT_URL=http://localhost:6333

# Dedicated models — the embedding model MUST differ from the generation model.
# Defaults are local (no API key). To use 4Geeks-hosted models, set the model
# IDs plus their base URL / API key here.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL=google/flan-t5-base
# LLM_BASE_URL=
# LLM_API_KEY=
